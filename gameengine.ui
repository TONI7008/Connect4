         <property name="styleSheet">
          <string notr="true">QPushButton {
    border: 2px solid rgb(5, 40, 120);
    border-radius: 12px;

    /* Base plastic gradient */
    background: qlineargradient(
        x1:0, y1:0, x2:1, y2:1,
        stop:0 rgb(60, 140, 255),   /* light */
        stop:0.4 rgb(30, 100, 220),
        stop:1 rgb(5, 40, 120)      /* deep shadow */
    );

    /* subtle top shine */
    padding: 6px;
    color: white;
    font-weight: bold;
}

QPushButton:hover {
    border: 2px solid rgb(10, 60, 160);

    background: qlineargradient(
        x1:0, y1:0, x2:1, y2:1,
        stop:0 rgb(90, 170, 255),
        stop:0.4 rgb(50, 120, 240),
        stop:1 rgb(10, 60, 160)
    );
}

QPushButton:pressed {
    border: 2px solid rgb(5, 30, 90);

    /* invert light direction for pressed effect */
    background: qlineargradient(
        x1:0, y1:1, x2:1, y2:0,
        stop:0 rgb(30, 90, 200),
        stop:0.5 rgb(10, 60, 150),
        stop:1 rgb(5, 30, 90)
    );

    padding-top: 8px;
    padding-bottom: 4px;
}
</string>
